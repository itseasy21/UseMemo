<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hardened-runtime entitlement required for microphone access. Without it a
		signed build starts a stream that only ever delivers silence.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
