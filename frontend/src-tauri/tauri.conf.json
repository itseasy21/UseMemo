{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Use Memo",
  "mainBinaryName": "use-memo",
  "version": "0.1.0",
  "identifier": "org.gnu.usememo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Use Memo",
        "width": 1360,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "theme": "Dark"
      },
      {
        "label": "hud",
        "title": "Use Memo HUD",
        "url": "/hud",
        "width": 320,
        "height": 48,
        "minWidth": 320,
        "minHeight": 48,
        "maxWidth": 420,
        "maxHeight": 280,
        "center": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCACHE/**",
          "$TEMP/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/brand.config.json"
    ],
    "category": "Productivity",
    "shortDescription": "Local-First AI Meeting & Note Studio",
    "longDescription": "Use Memo — Local-First AI Meeting & Note Studio. Use Memo Project (GNU GPLv3).",
    "copyright": "© 2026 Use Memo Project (GNU GPLv3)",
    "license": "GPL-3.0-or-later",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "usememo"
        ]
      }
    }
  }
}
